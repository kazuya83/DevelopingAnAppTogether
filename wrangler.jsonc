{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "developing-an-app-together",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // 画面（public/）と API（src/）を 1 つの Worker で配る。API と .well-known は Worker が先に処理する
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/.well-known/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "developing-an-app-together",
      // `npx wrangler d1 create developing-an-app-together` で表示された ID に置き換える
      "database_id": "f5c4e442-51aa-4e6d-9249-b0a1d8ba62c3",
      "migrations_dir": "migrations"
    }
  ],
  // 5 分ごとに、Issue 化に失敗した提案を作り直し、Issue の開発の進み具合（開発中・反映済みなど）を取り込む
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // Issue にする「いいね」の数
    "LIKE_THRESHOLD": "5",
    // Issue を作るリポジトリ（owner/name）
    "GITHUB_REPO": "kazuya83/DevelopingAnAppTogether",
    // Issue に付けるラベル（Mac の Claude はこのラベルの Issue を拾う）
    "GITHUB_ISSUE_LABEL": "from-app",
    // 管理者のユーザ名（カンマ区切り）。投稿・コメントの削除と通報の確認ができる
    "ADMIN_USERNAMES": "hoge",
    // パスキー用。iOS アプリの「TeamID.バンドルID」（例: ABCDE12345.com.example.together）
    "APPLE_APP_ID": "Y9YNQSMN52.com.kazuya83.developinganapptogether",
    "RP_NAME": "みんなでアプリ開発",
    // iOS アプリの通知（APNs）。鍵の中身は `npx wrangler secret put APNS_KEY` で入れる。APNS_KEY_ID が空なら通知は送らない
    "APNS_KEY_ID": "",
    "APNS_TEAM_ID": "Y9YNQSMN52",
    "APNS_TOPIC": "com.kazuya83.developinganapptogether"
  },
  "observability": { "enabled": true }
}
